# ============================================================
# PAItryk — environment configuration
# Copy to .env and fill in. .env is gitignored.
# ============================================================

# --- LLM provider for chat (runtime-switchable) ---
# Options: "claude" | "ollama"
CHAT_PROVIDER=ollama
INGEST_PROVIDER=ollama

# --- Anthropic (production chat) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Ollama (local — testing, ingest, fallback) ---
OLLAMA_HOST=http://localhost:11434
# Chat model (when CHAT_PROVIDER=ollama)
OLLAMA_CHAT_MODEL=qwen3.5:122b-a10b
# Ingest / extraction model (always local — never hits API)
OLLAMA_INGEST_MODEL=qwen3.5:122b-a10b
# Embeddings (always local)
OLLAMA_EMBED_MODEL=qwen3-embedding:8b
# Reranker (always local)
OLLAMA_RERANKER_MODEL=dengcao/Qwen3-Reranker-8B:Q5_K_M

# --- Vector store (Qdrant embedded — local file) ---
QDRANT_PATH=data/qdrant
QDRANT_COLLECTION=paitryk_memories
CHAT_DB_PATH=data/processed/chats.sqlite3
AUTH_DB_PATH=data/processed/auth.sqlite3
RAG_SEARCH_LIMIT=24
RAG_CONTEXT_LIMIT=8
RAG_SCORE_THRESHOLD=0.25

# --- Auth (single-user MVP) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
SESSION_SECRET=change-me
SESSION_COOKIE_SECURE=false

# --- Server ---
# Ustaw 0.0.0.0 jeśli chcesz dostęp z innych maszyn w sieci (LAN/VPN).
# Frontend Next.js robi rewrites /api/* → http://127.0.0.1:8010/api/* po swojej stronie,
# więc klient gada tylko do FRONTEND_PORT (same-origin, CORS go nie dotyczy).
BACKEND_HOST=0.0.0.0
BACKEND_PORT=8010
FRONTEND_HOST=0.0.0.0
FRONTEND_PORT=3002
FRONTEND_ORIGIN=http://localhost:3002
FRONTEND_ORIGINS=http://localhost:3000,http://127.0.0.1:3000,http://localhost:3002,http://127.0.0.1:3002

# --- Logging ---
LOG_LEVEL=INFO
