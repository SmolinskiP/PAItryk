# ============================================================
# PAItryk — environment configuration
# Copy to .env and fill in. .env is gitignored.
# ============================================================

# --- LLM provider for chat (runtime-switchable) ---
# Options: "claude" | "ollama"
CHAT_PROVIDER=claude

# --- Anthropic (production chat) ---
ANTHROPIC_API_KEY=sk-ant-...
ANTHROPIC_MODEL=claude-sonnet-4-6

# --- Ollama (local — testing, ingest, fallback) ---
OLLAMA_HOST=http://localhost:11434
# Chat model (when CHAT_PROVIDER=ollama)
OLLAMA_CHAT_MODEL=qwen3.5:122b-a10b
# Ingest / extraction model (always local — never hits API)
OLLAMA_INGEST_MODEL=qwen3.5:122b-a10b
# Embeddings (always local)
OLLAMA_EMBED_MODEL=qwen3-embedding:8b
# Reranker (always local)
OLLAMA_RERANKER_MODEL=dengcao/Qwen3-Reranker-8B:Q5_K_M

# --- Vector store (Qdrant embedded — local file) ---
QDRANT_PATH=./data/qdrant

# --- Auth (single-user MVP) ---
# Generate with: python -c "import secrets; print(secrets.token_urlsafe(32))"
ADMIN_PASSWORD=change-me
SESSION_SECRET=change-me

# --- Server ---
BACKEND_HOST=127.0.0.1
BACKEND_PORT=8000
FRONTEND_ORIGIN=http://localhost:3000

# --- Logging ---
LOG_LEVEL=INFO
